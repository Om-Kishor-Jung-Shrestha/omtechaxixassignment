loki.source.journal "jenkins_controller" {
  matches = "_SYSTEMD_UNIT=jenkins.service"

  labels = {
    job  = "jenkins",
    host = "jenkins-controller",
  }

  forward_to = [loki.write.central.receiver]
}

loki.write "central" {
  endpoint {
    url = "http://MONITORING_PRIVATE_IP:3100/loki/api/v1/push"
  }
}
